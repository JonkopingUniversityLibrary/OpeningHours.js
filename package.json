{
    "name": "opening-hours",
    "description": "Buildtools for Jönköping University Library development",
    "main": "gulpfile.js",
    "repository": "https://github.com/JonkopingUniversityLibrary/OpeningHours.js",
		"watch": {
			"compile-css": {
				"patterns": [
					"_css"
				],
				"extensions": "css",
				"quiet": false,
				"legacyWatch": true,
				"runOnChangeOnly": false
			}
		},
    "scripts": {
        "compile-css": "postcss _css/main.css -o assets/css/ju-library-openinghours.css",
        "watch-css": "npm-watch compile-css"
    },
    "author": "Gustav Lindqvist",
    "license": "MIT",
    "dependencies": {
        "autoprefixer": "^10.4.24",
        "cssnano": "^7.1.2",
        "eslint-config-prettier": "^9.1.0",
        "gulp": "^5.0.0",
        "gulp-autoprefixer": "^9.0.0",
        "gulp-csscomb": "^3.1.0",
        "gulp-cssnano": "^2.1.3",
        "gulp-gzip": "^1.4.2",
        "gulp-plumber": "^1.2.1",
        "gulp-rename": "^2.0.0",
        "gulp-sass": "^6.0.0",
        "gulp-sass-glob": "^1.1.0",
        "gulp-sourcemaps": "^3.0.0",
        "npm-watch": "^0.13.0",
        "postcss": "^8.5.6",
        "postcss-cli": "^11.0.1",
        "postcss-custom-media": "^12.0.0",
        "postcss-import": "^16.1.1",
        "postcss-import-ext-glob": "^2.1.1",
        "postcss-nesting": "^14.0.0",
        "prettier": "^3.4.2",
        "prettier-eslint": "^16.3.0",
        "prettier-plugin-css-order": "^2.1.2",
        "sass": "^1.83.0"
    }
}
